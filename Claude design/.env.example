# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
NODE_ENV=development
APP_NAME=canteen-management
APP_PORT=3000
API_PORT=4000
WORKER_PORT=4001

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=canteen
POSTGRES_PASSWORD=canteen_secret
POSTGRES_DB=canteen_db
DATABASE_URL=postgresql://canteen:canteen_secret@localhost:5432/canteen_db?schema=public

# ──────────────────────────────────────────────
# Redis / Valkey
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379

# ──────────────────────────────────────────────
# Keycloak (Auth)
# ──────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=canteen
KEYCLOAK_CLIENT_ID=canteen-api
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secret

# ──────────────────────────────────────────────
# MinIO (Object Storage)
# ──────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=canteen_minio
MINIO_SECRET_KEY=minio_secret
MINIO_BUCKET=canteen-assets
MINIO_USE_SSL=false

# ──────────────────────────────────────────────
# Meilisearch
# ──────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=meili_master_key

# ──────────────────────────────────────────────
# BullMQ / Queue
# ──────────────────────────────────────────────
QUEUE_REDIS_URL=redis://:redis_secret@localhost:6379/1

# ──────────────────────────────────────────────
# JWT (fallback if not using Keycloak)
# ──────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ──────────────────────────────────────────────
# Next.js (Web)
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=canteen
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=canteen-web

# ──────────────────────────────────────────────
# Observability
# ──────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=canteen-api
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
LOKI_PORT=3100

# ──────────────────────────────────────────────
# SMTP (Notifications)
# ──────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@canteen.local
